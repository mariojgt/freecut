# ===========================================
# Frontend Configuration (Vite)
# ===========================================

# Show/hide floating debug button in editor (dev mode only)
# Set to 'false' to hide debug panel button during development
VITE_SHOW_DEBUG_PANEL=true

# ===========================================
# Self-hosting (Docker Compose)
# ===========================================
# Compose reads this file automatically, so these are set once and never typed
# again: `docker compose up -d` brings up the editor, the render API, and the
# MCP endpoint together, all with restart: unless-stopped.

# Where projects, media, and caches live on the host.
FREECUT_WORKSPACE=./freecut-workspace
# Where rendered files the MCP tools produce are written.
FREECUT_MCP_OUTPUT=./freecut-output

# Published ports.
FREECUT_WEB_PORT=8080
FREECUT_API_PORT=8787
FREECUT_MCP_PORT=8788

# Opening FreeCut from another machine.
# Browsers expose the workspace storage APIs only in a secure context, and a
# LAN address over plain HTTP is not one — http://192.168.x.x:8080 makes the
# app report an unsupported browser even in Chrome. Selecting the `https`
# profile starts a Caddy front door that terminates TLS with its own local CA.
# Uncomment both lines and set the host to the address typed in the browser,
# because the certificate is issued for exactly that name.
# COMPOSE_PROFILES=https
# FREECUT_PUBLIC_HOST=192.168.1.50
FREECUT_HTTPS_PORT=443

# Interface the MCP endpoint is published on. Loopback by default, so a fresh
# `up` never puts an unauthenticated endpoint on the network. Set 0.0.0.0 to
# reach it from another machine — pair that with FREECUT_MCP_TOKEN, or with a
# reverse proxy that authenticates, because this endpoint can read and write
# every project in the workspace.
FREECUT_MCP_BIND=127.0.0.1

# Optional bearer token for the MCP endpoint. Empty means no auth.
FREECUT_MCP_TOKEN=
# Optional bearer token for the render API.
FREECUT_API_TOKEN=
